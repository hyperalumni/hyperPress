{
  "name": "@hyper/press",
  "private": true,
  "scripts": {
    "audit": "pnpm install --no-frozen-lockfile; pnpm audit --fix=override --interactive; pnpm install --no-frozen-lockfile; pnpm dedupe;",
    "preinstall": "npx only-allow pnpm",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "inup": "pnpm dlx inup",
    "knip": "pnpm dlx knip"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.20.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "error"
    }
  },
  "engines": {
    "node": "26.13.1"
  },
  "devDependencies": {
    "@nx/oxlint": "catalog:",
    "@nx/vite": "catalog:",
    "@nx/workspace": "catalog:",
    "nx": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "stylelint": "catalog:",
    "stylelint-config-standard-scss": "catalog:"
  }
}
