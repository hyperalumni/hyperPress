{
  "name": "@hyper/press",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.12.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "26.12.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": "26.12.0"
  },
  "devDependencies": {
    "@nx/oxlint": "catalog:",
    "@nx/vite": "catalog:",
    "nx": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "postcss-scss": "catalog:",
    "stylelint": "catalog:",
    "stylelint-config-standard-scss": "catalog:"
  }
}
