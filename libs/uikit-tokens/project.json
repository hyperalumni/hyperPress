{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@hyper/uikit-tokens",
  "targets": {
    "build": {
      "executor": "nx:run-script",
      "options": { "script": "build" },
      "cache": true,
      "inputs": ["default", "^default"],
      "outputs": ["{workspaceRoot}/dist/libs/uikit-tokens"]
    },
    "test": {
      "executor": "nx:run-script",
      "options": { "script": "test" },
      "cache": true,
      "inputs": ["default", "^default"]
    }
  }
}
