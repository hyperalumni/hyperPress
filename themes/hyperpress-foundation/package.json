{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@hyper/press-foundation",
  "title": "HYPER Press",
  "description": "hyperPress is a fork of FoundationPress (based on Foundation 6 by Zurb) for HYPER WordPress sites",
  "homepage": "https://hyperpress.idesign.co",
  "license": "MIT",
  "private": true,
  "main": "gulpfile.mjs",
  "scripts": {
    "audit": "pnpm install --no-frozen-lockfile; pnpm audit --fix=override --interactive; pnpm install --no-frozen-lockfile; pnpm dedupe;",
    "build": "gulp build --production",
    "dev": "gulp build --dev",
    "inup": "pnpm dlx inup",
    "knip": "pnpm dlx knip",
    "outdated": "pnpm inup; pnpm dedupe",
    "package": "gulp package --production",
    "phpcs": "gulp phpcs",
    "phpcbf": "gulp phpcbf",
    "preinstall": "npx only-allow pnpm",
    "start": "gulp",
    "test:node": "node --test 'tests/node/*.test.mjs'"
  },
  "dependencies": {
    "foundation-sites": "catalog:foundation",
    "jquery": "catalog:foundation",
    "motion-ui": "catalog:foundation",
    "what-input": "catalog:foundation"
  },
  "devDependencies": {
    "@babel/core": "catalog:foundation",
    "@babel/preset-env": "catalog:foundation",
    "ansi-colors": "catalog:foundation",
    "babel-loader": "catalog:foundation",
    "browser-sync": "catalog:foundation",
    "dateformat": "catalog:foundation",
    "fancy-log": "catalog:foundation",
    "gulp": "catalog:foundation",
    "gulp-autoprefixer": "catalog:foundation",
    "gulp-clean-css": "catalog:foundation",
    "gulp-cli": "catalog:foundation",
    "gulp-concat": "catalog:foundation",
    "gulp-extname": "catalog:foundation",
    "gulp-if": "catalog:foundation",
    "gulp-imagemin": "catalog:foundation",
    "gulp-phpcbf": "catalog:foundation",
    "gulp-phpcs": "catalog:foundation",
    "gulp-rename": "catalog:foundation",
    "gulp-rev": "catalog:foundation",
    "gulp-sass": "catalog:foundation",
    "gulp-sourcemaps": "catalog:foundation",
    "gulp-uglify": "catalog:foundation",
    "gulp-zip": "catalog:foundation",
    "imagemin-gifsicle": "catalog:foundation",
    "imagemin-jpegtran": "catalog:foundation",
    "imagemin-optipng": "catalog:foundation",
    "imagemin-svgo": "catalog:foundation",
    "js-yaml": "catalog:foundation",
    "panini": "catalog:foundation",
    "rimraf": "catalog:foundation",
    "sass-embedded": "catalog:foundation",
    "style-sherpa": "catalog:foundation",
    "vinyl-named": "catalog:foundation",
    "webpack": "catalog:foundation",
    "webpack-stream": "catalog:foundation",
    "yargs": "catalog:foundation"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hyperalumni/hyperPress.git"
  },
  "babel": {
    "presets": [
      "@babel/preset-env"
    ],
    "compact": false
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "26.12.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": "26.12.0"
  }
}
