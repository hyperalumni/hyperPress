<?xml version="1.0"?>
<ruleset name="HYPERpress UIkit theme">
    <description>WordPress coding standards and PHP compatibility for the HYPERpress UIkit theme.</description>

    <file>.</file>

    <!-- Views are Twig, not PHP; vendor, build output and dependencies are not ours. -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/dist/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="parallel" value="8"/>
    <arg value="sp"/>

    <config name="minimum_wp_version" value="6.9"/>
    <config name="testVersion" value="8.3-"/>

    <rule ref="WordPress">
        <!-- Mandatory docblock presence (file/class/function/variable) is documentation churn with no behavioral
             value; existing docblocks are still validated. Same exclusions as the plugins' ruleset. -->
        <exclude name="Squiz.Commenting.FileComment.Missing"/>
        <exclude name="Squiz.Commenting.FileComment.MissingPackageTag"/>
        <exclude name="Squiz.Commenting.ClassComment.Missing"/>
        <exclude name="Squiz.Commenting.FunctionComment.Missing"/>
        <exclude name="Squiz.Commenting.VariableComment.Missing"/>
    </rule>
    <rule ref="PHPCompatibilityWP"/>

    <!-- PSR-4 class files (inc/Assets.php) are named after the class, not class-*.php. -->
    <rule ref="WordPress.Files.FileName">
        <properties>
            <property name="strict_class_file_names" value="false"/>
        </properties>
        <exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
        <exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
    </rule>

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="hyperpress-uikit"/>
            </property>
        </properties>
    </rule>

    <!-- The theme class is PSR-4 object-oriented code (camelCase methods, properties and promoted parameters),
         matching the PSR-4 file names above; WPCS snake_case naming applies to procedural WordPress code. -->
    <rule ref="WordPress.NamingConventions.ValidFunctionName">
        <exclude name="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid"/>
    </rule>
    <rule ref="WordPress.NamingConventions.ValidVariableName">
        <exclude name="WordPress.NamingConventions.ValidVariableName.VariableNotSnakeCase"/>
        <exclude name="WordPress.NamingConventions.ValidVariableName.UsedPropertyNotSnakeCase"/>
        <exclude name="WordPress.NamingConventions.ValidVariableName.PropertyNotSnakeCase"/>
    </rule>

    <!-- Vite output is content-hashed in production and served by the dev server in development, so a ?ver=
         query adds nothing and would defeat HMR. -->
    <rule ref="WordPress.WP.EnqueuedResourceParameters.MissingVersion">
        <severity>0</severity>
    </rule>

    <!-- Tests run on plain temp directories and stub the probe callable; no WP_Filesystem, and unused stub parameters. -->
    <rule ref="WordPress.WP.AlternativeFunctions">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>
    <rule ref="Generic.CodeAnalysis.UnusedFunctionParameter">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>

    <!-- hp_uikit is the function/global prefix; a hyphenated hp-uikit is not a valid PHP prefix (handles are not checked). -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="HyperPress\Uikit"/>
                <element value="hp_uikit"/>
            </property>
        </properties>
    </rule>
</ruleset>
