{
  "name": "hyperpress/hyperpress-uikit",
  "description": "hyperPress UIkit theme (Timber + Vite)",
  "type": "wordpress-theme",
  "license": "MIT",
  "require": {
    "php": ">=8.3",
    "timber/timber": "^2.5.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "yoast/phpunit-polyfills": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "HyperPress\\Uikit\\": "inc/"
    }
  },
  "config": {
    "sort-packages": true
  },
  "scripts": {
    "test:unit": "phpunit --testsuite unit"
  }
}
