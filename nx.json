{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "!{projectRoot}/dist/**/*",
      "!{projectRoot}/vendor/**/*",
      "!{projectRoot}/node_modules/**/*"
    ]
  },
  "plugins": [
    {
      "plugin": "@nx/vite/plugin",
      "include": ["themes/hyperpress-uikit/**/*"],
      "options": {
        "buildTargetName": "vite-build",
        "serveTargetName": "vite-serve",
        "devTargetName": "vite-dev",
        "previewTargetName": "vite-preview",
        "serveStaticTargetName": "vite-serve-static",
        "typecheckTargetName": "vite-typecheck",
        "testTargetName": "vite-test",
        "buildDepsTargetName": "vite-build-deps",
        "watchDepsTargetName": "vite-watch-deps"
      }
    },
    {
      "plugin": "@nx/oxlint",
      "options": {
        "targetName": "lint-js"
      }
    }
  ],
  "targetDefaults": {
    "build": {
      "cache": true,
      "inputs": ["default", "^default"]
    },
    "test:node": {
      "cache": true,
      "inputs": ["default", "^default"]
    }
  },
  "analytics": false
}
